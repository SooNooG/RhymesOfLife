{
  "info": {
    "_postman_id": "1c4f1e9f-9e54-4f98-b970-2c1eb7a02001",
    "name": "Rhythms of Life Load Testing",
    "description": "Semi-automated Postman collection for load and performance testing of the Rhythms of Life Django portal. The collection uses real routes from base.urls, blog.urls, and RhymesOfLife.urls. Run folders separately for public, authenticated user, doctor, and staff scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const csrfToken = pm.environment.get(\"csrf_token\");",
          "const sessionId = pm.environment.get(\"sessionid\");",
          "",
          "if (csrfToken && !pm.request.headers.has(\"X-CSRFToken\")) {",
          "    pm.request.headers.add({ key: \"X-CSRFToken\", value: csrfToken });",
          "}",
          "",
          "if (csrfToken && !pm.request.headers.has(\"Cookie\")) {",
          "    let cookieValue = `csrftoken=${csrfToken}`;",
          "    if (sessionId) {",
          "        cookieValue += `; sessionid=${sessionId}`;",
          "    }",
          "    pm.request.headers.add({ key: \"Cookie\", value: cookieValue });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
